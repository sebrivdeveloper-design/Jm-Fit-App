<?xml version="1.0" encoding="utf-8"?>
<!-- HU-51: un cliente asignado al entrenador (mismo estilo que item_rutina). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/bg_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/jmfit_text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Camila Restrepo" />

            <TextView
                android:id="@+id/tvEstado"
                style="@style/TextAppearance.JmFit.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_activa"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/jmfit_primary"
                tools:text="Activo" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/jmfit_text_secondary"
            android:textSize="12sp"
            tools:text="\@camila" />

        <TextView
            style="@style/TextAppearance.JmFit.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/mcli_rutina"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvRutina"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/jmfit_text"
            android:textSize="13sp"
            tools:text="Hipertrofia — Fase 2" />
    </LinearLayout>
</LinearLayout>
