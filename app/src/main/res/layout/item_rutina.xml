<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/bg_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="6dp">

        <!-- Nombre y estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/jmfit_text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Hipertrofia — Fase 2" />

            <TextView
                android:id="@+id/tvEstado"
                style="@style/TextAppearance.JmFit.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_activa"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/jmfit_primary"
                tools:text="Activa" />
        </LinearLayout>

        <!-- Objetivo | Nivel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.JmFit.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rutinas_label_objetivo"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvObjetivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/jmfit_text"
                    android:textSize="13sp"
                    tools:text="Hipertrofia" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.JmFit.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rutinas_label_nivel"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvNivel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/jmfit_text"
                    android:textSize="13sp"
                    tools:text="Intermedio" />
            </LinearLayout>
        </LinearLayout>

        <!-- Ejercicios | Asignada a -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.JmFit.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rutinas_label_ejercicios"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvEjercicios"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/jmfit_text"
                    android:textSize="13sp"
                    tools:text="4" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bloqueAsignada"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.JmFit.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rutinas_label_asignada"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvAsignada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/jmfit_text"
                    android:textSize="13sp"
                    tools:text="Camila Restrepo" />
            </LinearLayout>
        </LinearLayout>

        <!-- Acciones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnVer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/rutinas_cd_ver"
                android:padding="9dp"
                android:src="@drawable/ic_visibility"
                app:tint="@color/jmfit_text" />

            <ImageButton
                android:id="@+id/btnEditar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/rutinas_cd_editar"
                android:padding="9dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/jmfit_text" />

            <ImageButton
                android:id="@+id/btnEstadoRutina"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/rutinas_cd_inhabilitar"
                android:padding="9dp"
                android:src="@drawable/ic_power"
                app:tint="@color/jmfit_primary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
