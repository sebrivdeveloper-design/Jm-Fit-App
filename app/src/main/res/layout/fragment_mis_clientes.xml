<?xml version="1.0" encoding="utf-8"?>
<!-- HU-51 (Mis clientes) y HU-57 (contador de clientes activos). Mismo estilo que fragment_rutinas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:text="@string/mcli_seccion"
        android:textColor="@color/jmfit_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        style="@style/TextAppearance.JmFit.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:text="@string/trainer_tab_clientes" />

    <TextView
        style="@style/TextAppearance.JmFit.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:text="@string/mcli_subtitulo" />

    <!-- HU-57: total de clientes activos asignados -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_cli_tarjeta"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mcli_activos"
            android:textColor="@color/jmfit_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTotalActivos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/jmfit_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="3" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilBuscar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        app:endIconMode="clear_text"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/jmfit_text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mcli_buscar_hint"
            android:imeOptions="actionSearch"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvClientes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_mi_cliente" />

        <LinearLayout
            android:id="@+id/panelMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvMensaje"
                style="@style/TextAppearance.JmFit.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                tools:text="@string/mcli_vacio" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReintentar"
                style="@style/Widget.JmFit.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/mcli_reintentar"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/barraEntrenador"
        style="@style/Widget.JmFit.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_entrenador" />
</LinearLayout>
