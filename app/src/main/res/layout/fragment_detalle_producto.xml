<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Barra superior: volver, título y carrito con contador -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnAtras"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tienda_volver"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/jmfit_text" />

        <TextView
            android:id="@+id/tvTituloPantalla"
            style="@style/TextAppearance.Material3.TitleLarge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/tienda_titulo_detalle"
            android:textColor="@color/jmfit_text"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/btnCarrito"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/tienda_cd_carrito"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_cart"
                app:tint="@color/jmfit_text" />

            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:minWidth="18dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="3"
                tools:visibility="visible" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/contenido"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <ImageView
                    android:id="@+id/ivProducto"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/jmfit_field"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/ic_producto_placeholder" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvMarcaCategoria"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.05"
                            android:textColor="@color/jmfit_text_secondary"
                            android:textSize="12sp"
                            tools:text="PULSO NUTRITION · PROTEÍNAS" />

                        <TextView
                            android:id="@+id/tvCalificacion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/jmfit_primary"
                            android:textSize="13sp"
                            tools:text="★ 4,9" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/jmfit_text"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="Whey isolate" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPresentacion"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/jmfit_text_secondary"
                            android:textSize="14sp"
                            tools:text="900 g · Vainilla" />

                        <TextView
                            android:id="@+id/tvDisponibilidad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="● Disponible"
                            tools:textColor="@color/jmfit_success" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPrecio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/jmfit_text"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="$149.900" />

                    <TextView
                        android:id="@+id/tvDescripcion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/jmfit_text"
                        android:textSize="14sp"
                        tools:text="25 g de proteína por porción para apoyar tu recuperación muscular." />

                    <TextView
                        android:id="@+id/tvObjetivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/jmfit_text_secondary"
                        android:textSize="13sp"
                        tools:text="Objetivo: Recuperación muscular" />

                    <TextView
                        android:id="@+id/tvBeneficiosTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/tienda_beneficios"
                        android:textColor="@color/jmfit_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBeneficios"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/jmfit_text_secondary"
                        android:textSize="14sp"
                        tools:text="•  25 g de proteína por porción\n•  Bajo en azúcar" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/progreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/jmfit_primary" />

        <TextView
            android:id="@+id/tvNoEncontrado"
            style="@style/TextAppearance.JmFit.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/tienda_producto_no_encontrado"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Barra inferior: cantidad, total y botón -->
    <LinearLayout
        android:id="@+id/barraInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/jmfit_outline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenos"
                style="@style/Widget.JmFit.Button.Outlined"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/tienda_disminuir"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="−"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvCantidad"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/jmfit_text"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMas"
                style="@style/Widget.JmFit.Button.Outlined"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/tienda_aumentar"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="+"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/jmfit_text"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="$149.900" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgregar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/tienda_agregar" />
    </LinearLayout>
</LinearLayout>
