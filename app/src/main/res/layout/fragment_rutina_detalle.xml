<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolver"
            style="@style/Widget.JmFit.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:insetLeft="0dp"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:text="@string/detalle_volver"
            app:icon="@drawable/ic_arrow_back"
            app:iconPadding="6dp"
            app:iconSize="18dp" />

        <!-- Error / no disponible -->
        <LinearLayout
            android:id="@+id/bloqueMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvMensaje"
                style="@style/TextAppearance.JmFit.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                tools:text="@string/detalle_no_disponible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReintentar"
                style="@style/Widget.JmFit.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/detalle_reintentar" />
        </LinearLayout>

        <!-- Contenido -->
        <LinearLayout
            android:id="@+id/bloqueContenido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvTipo"
                style="@style/TextAppearance.JmFit.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chip_inhabilitada"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/jmfit_text_secondary"
                tools:text="Personalizada" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNombreDetalle"
                    style="@style/TextAppearance.JmFit.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="22sp"
                    tools:text="Hipertrofia — Fase 2" />

                <TextView
                    android:id="@+id/tvEstadoDetalle"
                    style="@style/TextAppearance.JmFit.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_activa"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/jmfit_primary"
                    tools:text="Activa" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_divider" />

            <!-- Datos generales -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.JmFit.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rutinas_label_objetivo"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvObjetivoDetalle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/jmfit_text"
                        android:textSize="14sp"
                        tools:text="Hipertrofia" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.JmFit.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rutinas_label_nivel"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvNivelDetalle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/jmfit_text"
                        android:textSize="14sp"
                        tools:text="Intermedio" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bloqueAsignadaDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.JmFit.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rutinas_label_asignada"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvAsignadaDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/jmfit_text"
                    android:textSize="14sp"
                    tools:text="Camila Restrepo" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bloqueNotas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.JmFit.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detalle_notas"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvNotasDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/jmfit_text"
                    android:textSize="14sp"
                    tools:text="Subir peso cuando se completen todas las series." />
            </LinearLayout>

            <!-- Días y ejercicios (se agregan por código) -->
            <LinearLayout
                android:id="@+id/contenedorDias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvSinEjercicios"
                style="@style/TextAppearance.JmFit.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/detalle_sin_ejercicios"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
