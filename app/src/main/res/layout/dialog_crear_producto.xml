<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_modal"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTituloModal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/modal_titulo"
                android:textColor="@color/texto"
                android:textSize="21sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCerrarModal"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_cerrar"
                android:contentDescription="@string/cerrar" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvDescripcionModal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="18dp"
            android:text="@string/modal_descripcion"
            android:textColor="@color/gris"
            android:textSize="12sp" />

        <TextView
            style="@style/LabelCampo"
            android:text="@string/nombre_producto_requerido" />

        <EditText
            android:id="@+id/etNombreProducto"
            style="@style/CampoFormulario"
            android:hint="@string/hint_nombre"
            android:inputType="textCapSentences" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical">

                <TextView
                    style="@style/LabelCampo"
                    android:text="@string/marca_requerida" />

                <EditText
                    android:id="@+id/etMarca"
                    style="@style/CampoFormulario"
                    android:hint="@string/hint_marca"
                    android:inputType="textCapWords" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    style="@style/LabelCampo"
                    android:text="@string/precio_requerido" />

                <EditText
                    android:id="@+id/etPrecio"
                    style="@style/CampoFormulario"
                    android:hint="@string/hint_precio"
                    android:inputType="numberDecimal"
                    android:digits="0123456789.," />

            </LinearLayout>

        </LinearLayout>

        <TextView
            style="@style/LabelCampo"
            android:layout_marginTop="12dp"
            android:text="@string/objetivo_requerido" />

        <EditText
            android:id="@+id/etObjetivo"
            style="@style/CampoFormulario"
            android:hint="@string/hint_objetivo"
            android:inputType="textCapSentences" />

        <TextView
            style="@style/LabelCampo"
            android:layout_marginTop="12dp"
            android:text="@string/presentacion_requerida" />

        <EditText
            android:id="@+id/etPresentacion"
            style="@style/CampoFormulario"
            android:hint="@string/hint_presentacion"
            android:inputType="textCapSentences" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activo"
                    android:textColor="@color/texto"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/activo_ayuda"
                    android:textColor="@color/gris"
                    android:textSize="11sp" />

            </LinearLayout>

            <Switch
                android:id="@+id/switchActivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:thumbTint="@color/blanco"
                android:trackTint="@color/naranja" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:text="@string/campos_obligatorios"
            android:textColor="@color/gris"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancelarProducto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_boton_secundario"
                android:backgroundTint="@null"
                android:text="@string/cancelar"
                android:textAllCaps="false"
                android:textColor="@color/texto" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGuardarProducto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_boton_naranja"
                android:backgroundTint="@null"
                android:text="@string/crear_producto"
                android:textAllCaps="false"
                android:textColor="@color/blanco"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>

