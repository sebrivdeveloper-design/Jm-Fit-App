<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_item_producto"
    android:elevation="2dp"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNombreProducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/texto"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Proteína whey" />

        <TextView
            android:id="@+id/tvEstadoProducto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="Activo" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/LabelProducto"
                android:text="@string/objetivo_label" />

            <TextView
                android:id="@+id/tvObjetivo"
                style="@style/ValorProducto"
                tools:text="Recuperación muscular" />

            <TextView
                style="@style/LabelProducto"
                android:layout_marginTop="10dp"
                android:text="@string/marca_label" />

            <TextView
                android:id="@+id/tvMarca"
                style="@style/ValorProducto"
                tools:text="NutriSport" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/LabelProducto"
                android:text="@string/presentacion_label" />

            <TextView
                android:id="@+id/tvPresentacion"
                style="@style/ValorProducto"
                tools:text="900 g - Vainilla" />

            <TextView
                style="@style/LabelProducto"
                android:layout_marginTop="10dp"
                android:text="@string/precio_label" />

            <TextView
                android:id="@+id/tvPrecio"
                style="@style/ValorProducto"
                android:textStyle="bold"
                tools:text="$ 34.900" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="7dp"
        android:background="@color/borde" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnVerProducto"
            style="@style/BotonAccion"
            android:src="@drawable/ic_ver"
            android:contentDescription="@string/ver_producto" />

        <ImageButton
            android:id="@+id/btnEditarProducto"
            style="@style/BotonAccion"
            android:src="@drawable/ic_editar"
            android:contentDescription="@string/editar_producto" />

        <ImageButton
            android:id="@+id/btnEstadoProducto"
            style="@style/BotonAccion"
            android:src="@drawable/ic_power"
            android:contentDescription="@string/desactivar_producto" />

    </LinearLayout>

</LinearLayout>
