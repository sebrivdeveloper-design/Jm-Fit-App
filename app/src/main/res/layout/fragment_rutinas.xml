<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Barra superior: sección y fecha de hoy -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/rutinas_seccion"
            android:textColor="@color/jmfit_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/jmfit_text_secondary"
            android:textSize="11sp"
            tools:text="Domingo, 1 de noviembre de 2026" />

        <TextView
            android:id="@+id/btnCerrarSesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackground"
            android:text="@string/placeholder_cerrar_sesion"
            android:textColor="@color/jmfit_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        style="@style/TextAppearance.JmFit.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:text="@string/rutinas_titulo" />

    <TextView
        style="@style/TextAppearance.JmFit.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:text="@string/rutinas_subtitulo" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCrearPersonalizada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:text="@string/rutinas_crear_personalizada"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleTipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEstandar"
            style="@style/Widget.JmFit.Button.Segment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rutinas_tab_estandar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPersonalizadas"
            style="@style/Widget.JmFit.Button.Segment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rutinas_tab_personalizadas" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilBuscar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/jmfit_text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/rutinas_buscar_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRutinas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_rutina" />

        <TextView
            android:id="@+id/tvVacio"
            style="@style/TextAppearance.JmFit.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone"
            tools:text="@string/rutinas_sin_resultados"
            tools:visibility="visible" />
    </FrameLayout>
</LinearLayout>
